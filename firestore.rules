rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function contest(code) {
      return get(/databases/$(database)/documents/contests/$(code)).data;
    }

    match /contests/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.hostUid == request.auth.uid;

      match /players/{uid} {
        allow read: if request.auth != null;

        // 학생은 자기 문서만 만들 수 있고, 점수는 0으로 시작한다.
        allow create: if request.auth != null
                      && request.auth.uid == uid
                      && request.resource.data.points == 0;

        // 학생은 이름만 고칠 수 있다. 점수는 교사만 바꾼다.
        allow update: if request.auth != null
                      && ((request.auth.uid == uid
                          && request.resource.data.points == resource.data.points)
                      || request.auth.uid == contest(code).hostUid);

        allow delete: if request.auth != null
                      && request.auth.uid == contest(code).hostUid;
      }

      match /results/{rid} {
        allow read: if request.auth != null;

        // 제출한 문장이 이번 라운드 원문과 정확히 같아야만 기록이 남는다.
        // 정확도 판정을 서버(보안 규칙)가 직접 하는 셈이다.
        allow create: if request.auth != null
                      && request.resource.data.uid == request.auth.uid
                      && rid == string(request.resource.data.roundNo) + '__' + request.auth.uid
                      && contest(code).status == 'racing'
                      && request.resource.data.roundNo == contest(code).roundNo
                      && request.resource.data.text == contest(code).text
                      && request.resource.data.ms >= contest(code).minMs;

        // 한 번 낸 기록은 학생이 고치거나 지울 수 없다.
        allow update, delete: if request.auth != null
                              && request.auth.uid == contest(code).hostUid;
      }
    }
  }
}
